{
  "id": "docker",
  "name": "Docker",
  "version": "1.2.1",
  "description": "Manage Docker and Podman containers on your hosts over SSH, with logs, stats and a console.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Docker",
  "docs": "https://docs.termix.site/plugins/docker",
  "video": "https://www.youtube.com/watch?v=V7F5w_dd0eM",
  "category": "Infrastructure",
  "icon": "Box",
  "features": [
    "Start, stop, restart, pause and remove containers",
    "Live CPU, memory, network and disk stats",
    "Read and download container logs",
    "Open a shell inside a container",
    "Works with Docker and Podman",
    "A containers panel beside any SSH terminal",
    "Optional stack management for compose projects",
    "Check images for updates and update containers",
    "A dashboard card with running and stopped containers on each host"
  ],
  "engine": {
    "termix": ">=26.10.3",
    "api": "^1.9"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "ssh:connect",
    "network:serve",
    "ui:surface",
    "events:core",
    "users:impersonate"
  ],
  "provides": [
    {
      "service": "docker.containers",
      "version": "1.0.0",
      "permission": "docker.use"
    },
    {
      "service": "docker.events",
      "version": "1.0.0",
      "permission": "docker.use"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "docker",
        "titleKey": "nav.docker",
        "icon": "Box",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "host": {
        "editorGroup": "ssh",
        "editorOrder": 30,
        "enableKey": "enableDocker",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "fields": [
          {
            "key": "containerRuntime",
            "type": "select",
            "labelKey": "settings.host.containerRuntime.label",
            "descriptionKey": "settings.host.containerRuntime.description",
            "requires": "enableDocker",
            "default": "docker",
            "options": [
              {
                "value": "docker",
                "labelKey": "settings.host.containerRuntime.docker"
              },
              {
                "value": "podman",
                "labelKey": "settings.host.containerRuntime.podman"
              }
            ]
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableDocker"
          },
          {
            "key": "enableStacks",
            "type": "boolean",
            "labelKey": "settings.host.enableStacks.label",
            "descriptionKey": "settings.host.enableStacks.description",
            "default": false,
            "requires": "enableDocker"
          },
          {
            "key": "stacksRoot",
            "type": "string",
            "labelKey": "settings.host.stacksRoot.label",
            "descriptionKey": "settings.host.stacksRoot.description",
            "default": "/opt/stacks",
            "requires": "enableStacks"
          }
        ]
      },
      "user": [
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 380
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ],
      "admin": [
        {
          "key": "stacksEnabled",
          "type": "boolean",
          "labelKey": "settings.admin.stacksEnabled.label",
          "descriptionKey": "settings.admin.stacksEnabled.description",
          "default": false
        }
      ]
    },
    "uiPresets": {
      "simple": {
        "viewMode": "list",
        "containerLayout": "card"
      },
      "balanced": {
        "viewMode": "list",
        "containerLayout": "card"
      },
      "advanced": {
        "viewMode": "detail",
        "containerLayout": "table"
      }
    },
    "uses": ["homepage.widgets", "terminal.resolveTheme"],
    "dashboardCards": [
      {
        "id": "docker-hosts",
        "titleKey": "card.title",
        "icon": "Box"
      }
    ]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
