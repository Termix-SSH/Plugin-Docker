{
  "id": "docker",
  "name": "Docker",
  "version": "1.3.0",
  "description": "Manage Docker and Podman containers on your hosts over SSH, with logs, stats and a console.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Docker",
  "docs": "https://docs.termix.site/plugins/docker",
  "video": "https://www.youtube.com/watch?v=CCzXPrdbGJc",
  "category": "Infrastructure",
  "icon": "Box",
  "features": [
    "Start, stop, restart, pause and remove containers",
    "Live CPU, memory, network and disk stats",
    "Read and download container logs",
    "Open a shell inside a container",
    "Works with Docker and Podman",
    "A containers panel beside any SSH terminal",
    "Optional stack management for compose projects",
    "Check images for updates and update containers",
    "A dashboard card with running and stopped containers on each host"
  ],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "ssh:connect",
    "network:serve",
    "ui:surface",
    "events:core",
    "kv:own",
    "notify:send",
    "users:impersonate",
    "operations:provide"
  ],
  "provides": [
    {
      "service": "docker.containers",
      "version": "1.0.0",
      "permission": "docker.use"
    },
    {
      "service": "docker.events",
      "version": "1.0.0",
      "permission": "docker.use"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "docker",
        "titleKey": "nav.docker",
        "icon": "Box",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "host": {
        "editorGroup": "ssh",
        "editorOrder": 30,
        "enableKey": "enableDocker",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "fields": [
          {
            "key": "containerRuntime",
            "type": "select",
            "labelKey": "settings.host.containerRuntime.label",
            "descriptionKey": "settings.host.containerRuntime.description",
            "requires": "enableDocker",
            "default": "docker",
            "options": [
              {
                "value": "docker",
                "labelKey": "settings.host.containerRuntime.docker"
              },
              {
                "value": "podman",
                "labelKey": "settings.host.containerRuntime.podman"
              }
            ]
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableDocker"
          },
          {
            "key": "alertProblems",
            "type": "boolean",
            "labelKey": "settings.host.alertProblems.label",
            "descriptionKey": "settings.host.alertProblems.description",
            "default": false,
            "requires": "enableDocker"
          },
          {
            "key": "enableStacks",
            "type": "boolean",
            "labelKey": "settings.host.enableStacks.label",
            "descriptionKey": "settings.host.enableStacks.description",
            "default": false,
            "requires": "enableDocker"
          },
          {
            "key": "stacksRoot",
            "type": "string",
            "labelKey": "settings.host.stacksRoot.label",
            "descriptionKey": "settings.host.stacksRoot.description",
            "default": "/opt/stacks",
            "requires": "enableStacks"
          }
        ]
      },
      "user": [
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 380
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ],
      "admin": [
        {
          "key": "stacksEnabled",
          "type": "boolean",
          "labelKey": "settings.admin.stacksEnabled.label",
          "descriptionKey": "settings.admin.stacksEnabled.description",
          "default": false
        }
      ]
    },
    "uiPresets": {
      "simple": {
        "viewMode": "list",
        "containerLayout": "card"
      },
      "balanced": {
        "viewMode": "list",
        "containerLayout": "card"
      },
      "advanced": {
        "viewMode": "detail",
        "containerLayout": "table"
      }
    },
    "uses": ["homepage.widgets", "terminal.resolveTheme"],
    "dashboardCards": [
      {
        "id": "docker-hosts",
        "titleKey": "card.title",
        "icon": "Box"
      }
    ],
    "operations": {
      "actions": [
        {
          "id": "docker.list-containers",
          "titleKey": "operations.list.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableDocker": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "docker.summary",
          "titleKey": "operations.summary.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableDocker": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "docker.start-container",
          "titleKey": "operations.start.title",
          "icon": "Play",
          "scope": "resource",
          "resource": "docker.container",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableDocker": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true
          },
          "idempotent": true
        },
        {
          "id": "docker.stop-container",
          "titleKey": "operations.stop.title",
          "icon": "Square",
          "scope": "resource",
          "resource": "docker.container",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableDocker": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true
          },
          "idempotent": true
        },
        {
          "id": "docker.restart-container",
          "titleKey": "operations.restart.title",
          "icon": "RotateCw",
          "scope": "resource",
          "resource": "docker.container",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableDocker": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "docker.pause-container",
          "titleKey": "operations.pause.title",
          "icon": "Pause",
          "scope": "resource",
          "resource": "docker.container",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableDocker": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true
          },
          "idempotent": true
        },
        {
          "id": "docker.unpause-container",
          "titleKey": "operations.unpause.title",
          "icon": "Play",
          "scope": "resource",
          "resource": "docker.container",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableDocker": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true
          },
          "idempotent": true
        },
        {
          "id": "docker.remove-container",
          "titleKey": "operations.remove.title",
          "icon": "Trash2",
          "scope": "resource",
          "resource": "docker.container",
          "risk": "destructive",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableDocker": true
            }
          },
          "surfaces": {
            "mcp": false,
            "assistant": false
          },
          "inputs": [
            {
              "key": "force",
              "type": "boolean",
              "labelKey": "operations.remove.force",
              "default": false
            }
          ]
        }
      ],
      "resources": [
        {
          "id": "docker.container",
          "titleKey": "operations.container.title",
          "icon": "Box",
          "list": "docker.list-containers",
          "key": "id",
          "name": "name",
          "status": "state",
          "tab": "docker",
          "columns": [
            {
              "key": "image",
              "titleKey": "operations.container.image"
            },
            {
              "key": "status",
              "titleKey": "operations.container.status",
              "type": "status"
            },
            {
              "key": "ports",
              "titleKey": "operations.container.ports"
            }
          ],
          "filters": ["state"]
        }
      ],
      "signals": [
        {
          "id": "docker.unhealthy",
          "titleKey": "operations.unhealthy.title",
          "read": "docker.summary",
          "scope": "host",
          "kind": "count",
          "refreshSec": 60
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
